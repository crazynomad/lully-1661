# Site URL — used by canonical/hreflang generation in `lib/seo.ts` and by
# sitemap.ts / robots.ts. Set the production domain in Vercel; locally,
# leave the default unless you need https://localhost.
NEXT_PUBLIC_SITE_URL=https://lully1661.com

# Keystatic (production only — leave blank in local dev to use filesystem mode).
# These come from a Keystatic Cloud GitHub App you provision once.
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO_OWNER=crazynomad
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO_NAME=lully-1661
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Random 32+ bytes (e.g. `openssl rand -hex 32`)
KEYSTATIC_SECRET=

# Resend — transactional email for forms (festive orders, reservations,
# careers, B2B). Free tier covers v1 volume.
RESEND_API_KEY=
RESEND_FROM=noreply@lully1661.com

# Newsletter (Mailchimp OR Buttondown — pick one).
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# Cloudflare Turnstile — bot protection on every form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry — error tracking. Free tier is fine for v1.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Google Maps Embed — used by per-store pages. URL-restrict the key to
# lully1661.com in the GCP console before going to production.
GOOGLE_MAPS_EMBED_KEY=
